<Project>
  <!--
    Packable-only packaging switches (IN-07). This file evaluates AFTER each .csproj
    body, so '$(IsPackable)' is already known here (it is NOT yet set when
    Directory.Build.props evaluates — conditioning there would silently apply to
    nothing). GenerateDocumentationFile ships the XML doc comments as part of the
    NuGet package; it stays OFF for the internal test project, whose public test
    methods intentionally carry no XML docs (CS1591 would fail the
    warnings-as-errors gate there).
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      DocumentationFile MUST be set explicitly here: the SDK derives it from
      GenerateDocumentationFile in Microsoft.NET.Sdk.BeforeCommon.targets, which
      evaluates BEFORE this file is imported — a late GenerateDocumentationFile
      alone leaves DocumentationFile empty and no XML is emitted (verified:
      Release pack contained no XML until this line was added). It points at the
      OUTPUT dir (not obj/): the pack step collects the XML from the output, and
      an obj/-pathed file is never copied there (verified: NU5026 otherwise).
    -->
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    The repo-root README doubles as the NuGet package readme. Paths in imported
    files resolve against the importing project directory, so ../../README.md
    reaches the repo root from both src/* packable projects.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
