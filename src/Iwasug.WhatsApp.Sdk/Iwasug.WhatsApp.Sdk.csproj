<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Main SDK package (D-13: package ID = root namespace = Iwasug.WhatsApp.Sdk).
    TFM, LangVersion, nullable, and warnings-as-errors come from Directory.Build.props;
    package versions come from Directory.Packages.props (central management).
  -->
  <PropertyGroup>
    <RootNamespace>Iwasug.WhatsApp.Sdk</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Unofficial WhatsApp Web multi-device protocol SDK for .NET — pluggable session persistence, multi-account ready, clean-room implementation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Iwa Sugriwa</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <!--
      Phase 2 wire protocol (02-01 Task 3): versions live in Directory.Packages.props
      (central management is repo law — never inline). NSec covers the BCL's only gap
      on the Noise path (X25519); Google.Protobuf covers handshake-payload protos;
      Grpc.Tools runs protoc at build time only (PrivateAssets=all, no runtime dep).
    -->
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <!-- Public-surface tracking from day one (A5): every public API change must be declared. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Handshake-payload schema (02-03): minimal hand-written .proto (provenance in
    the file header). Grpc.Tools runs protoc at build time only; the version
    lives in Directory.Packages.props (central management is repo law).
    internal_access keeps the generated types out of the public surface, so this
    plan adds no PublicAPI entries (02-04 owns PublicAPI.Unshipped.txt).
  -->
  <ItemGroup>
    <Protobuf Include="Proto\handshake.proto" GrpcServices="None" OutputOptions="internal_access" />
    <!--
      Pairing payload schemas (03-01 tracer): hand-written ClientPayload envelope
      (registration + login contents) and the DeviceProps descriptor it embeds.
      Same provenance discipline and internal_access as handshake.proto.
    -->
    <Protobuf Include="Proto\client_payload.proto" GrpcServices="None" OutputOptions="internal_access" />
    <Protobuf Include="Proto\companion_reg.proto" GrpcServices="None" OutputOptions="internal_access" />
    <!--
      Pair-success container (03-04): hand-written ADV schema with the same
      provenance discipline and internal_access as the payload schemas above.
    -->
    <Protobuf Include="Proto\adv.proto" GrpcServices="None" OutputOptions="internal_access" />
    <!--
      Signal session/sender-key schemas (04-01): hand-written SessionStructure,
      SenderKeyRecordStructure, and Signal/PreKey/SenderKey wire messages,
      schema-sourced field-for-field from Baileys MIT WAProto.proto at commit
      0af2386 (see the file header). Same internal_access discipline: the
      generated types stay out of the public surface.
    -->
    <Protobuf Include="Proto\signal.proto" GrpcServices="None" OutputOptions="internal_access" />
    <!--
      Message plaintext schemas (04-02): hand-written Message/MessageKey/
      ContextInfo/ExtendedTextMessage/SKDM-wrapper subset, schema-sourced
      field-for-field from Baileys MIT WAProto.proto at commit 0af2386
      (see the file header). Same internal_access discipline: the
      generated types stay out of the public surface.
    -->
    <Protobuf Include="Proto\message.proto" GrpcServices="None" OutputOptions="internal_access" />
  </ItemGroup>

  <!--
    Internal-surface unit tests (plan 01-04): StoreRegistry.EnsureUnique (D-26) and
    StoreErrorSurface (D-21) are internal by design; the test assembly is the only
    internals consumer.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Iwasug.WhatsApp.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
