<Project>
  <!--
    Central package version management: every PackageReference in this repo takes its
    version here, not in the .csproj files. Versions are the registry-verified pins
    from .planning/phases/01-foundation-store-seam/01-RESEARCH.md (2026-10-07).
    Note: the similarly-named "abstractions" split of the Options package does not exist
    on nuget.org — IOptions<T> ships in Microsoft.Extensions.Options itself.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions 10.0.x servicing train (runtime 10.0.12) -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <!-- Testing package carries its own version line -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />

    <!-- Test stack -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />

    <!-- Public-surface tracking (A5) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!--
      Phase 2 wire protocol (02-01 Task 3): X25519 key agreement (NSec, MIT) +
      protobuf runtime + build-time .proto codegen. Central pins only — consuming
      projects reference these WITHOUT versions. Grpc.Tools is build-time-only
      (PrivateAssets=all on the reference) so no runtime dependency ships.
      All three verified against the nuget.org flatcontainer in 02-RESEARCH
      Package Legitimacy Audit (all OK, no SUS/SLOP) and re-confirmed for
      currency in 02-SPIKE-NOTES.md F7 (Grpc.Tools) / F6 (NSec shape).
    -->
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />

    <!-- Versioning (Development Tools: git-height SemVer2 + signed reproducible builds) -->
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />

    <!--
      Samples/docs only (License & provenance: QRCoder is MIT, renders the QR payload
      the SDK emits — the core SDK must never reference it).
    -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
</Project>
