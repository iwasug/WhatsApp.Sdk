<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Internal test project: the ONLY project type in this repo that references the runnable
    xunit.v3 package (the kit must stay a class library — Pitfall 3). D-12: this project is
    not packable; the solution contains exactly two packable projects.
    Deliberately NO PublicApiAnalyzers here (internal surface, not shipped).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      xunit.v3 runs on Microsoft.Testing.Platform; on .NET 10 SDK `dotnet test` runs it in
      the MTP mode selected by global.json's test.runner (see repo-root global.json,
      https://aka.ms/dotnet-test-mtp-error). TestingPlatformDotnetTestSupport is NOT used:
      the .NET 10 SDK rejects VSTest-mode MTP projects outright.

      KNOWN TOOLCHAIN QUIRK (IN-10, observed on SDK 10.0.401): passing the nologo
      flag to `dotnet test` exits 5 with "Zero tests ran" and a swallowed error —
      always invoke `dotnet test` WITHOUT that flag. (The flag remains fine for
      `dotnet build`.) Re-test this quirk
      on every SDK servicing update before removing this note.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NSubstitute" />
    <!-- FakeTimeProvider for deterministic TTL/trim tests (consumed by plan 01-04). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!--
      The 02-02 loopback peer performs real X25519 agreement against the client's
      ephemeral (tracer design: real keys, scripted bytes). Versionless: the version
      lives in Directory.Packages.props (02-01 pin, reused — no new package).
    -->
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iwasug.WhatsApp.Sdk\Iwasug.WhatsApp.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Iwasug.WhatsApp.Sdk.Testing\Iwasug.WhatsApp.Sdk.Testing.csproj" />
  </ItemGroup>

  <!--
    Golden fixtures (02-03): committed vector/frame data copied next to the
    test binary. The JSON itself is never modified by tests — it is read-only
    proof input (T-2-05: vectors imported, never self-generated).
  -->
  <ItemGroup>
    <Content Include="TestData\noise-xx-aesgcm-vectors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\client-payload-login.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\client-payload-registration.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\pair-success-container.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
